DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Wajib, minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000

# Cloudinary (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Secret bersama dengan FE (Vercel) untuk menandatangani hasil OCR KTP.
# Nilainya HARUS sama dengan KYC_ATTESTATION_SECRET di rongsokin-web. Min 32 karakter.
# Kosong = mode legacy (NIK dari client dipercaya mentah, tidak disarankan).
KYC_ATTESTATION_SECRET=
