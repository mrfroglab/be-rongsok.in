DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Wajib, minimal 32 karakter. Generate: openssl rand -hex 48
JWT_SECRET=
PORT=3000

# Origin yang boleh memanggil API dari browser (dipisah koma). Kosong = semua (dev).
CORS_ORIGINS=
# Dipakai untuk tautan reset password di email.
FRONTEND_URL=http://localhost:3000

# Cloudinary (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP untuk email lupa password (465 = TLS langsung, lainnya STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Secret bersama dengan FE untuk menandatangani hasil OCR KTP.
# Nilainya HARUS sama dengan KYC_ATTESTATION_SECRET di rongsokin-web. Min 32 karakter.
# Kosong = mode legacy (NIK dari client dipercaya mentah, tidak disarankan).
KYC_ATTESTATION_SECRET=

# Password admin untuk seeder (hanya dipakai saat DB masih kosong). Kosong = acak.
SEED_ADMIN_PASSWORD=
